# Gemini API キー（TAM/SAM/SOM 推計で使用）
# https://aistudio.google.com/apikey で発行
GOOGLE_API_KEY=your_api_key_here

# J-Quants API（4象限の信用倍率。リフレッシュトークンはマイページから取得）
# https://jpx-jquants.com/  ※週次信用残は「信用取引データ」付きプラン（目安: Standard ¥3,300/月〜）が必要なことが多い。無料のみでは取得できない場合あり。
JQUANTS_REFRESH_TOKEN=your_jquants_refresh_token_here
# バックテスト連携時の4象限フィルタ（任意）
# QUADRANT_MIN_SCORE=50
# QUADRANT_TOP_N=0
